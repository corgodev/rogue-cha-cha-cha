{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Launch (C# + GDScript)",
            "configurations": [
                "Combined: GDScript",
                "Combined: C#"
            ],
            "preLaunchTask": "build",
            "stopAll": true,
            "presentation": {
                "order": 0
            }
        },
        {
            "name": "Launch (Select Scene, C# + GDScript)",
            "configurations": [
                "Combined: GDScript",
                "Combined: C# (Select Scene)"
            ],
            "preLaunchTask": "build",
            "stopAll": true,
            "presentation": {
                "order": 1
            }
        }
    ],
    "configurations": [
        // Only the C# session launches a process. GDScript listens for that game's connection.
        // Keep port 6008 in sync with the wait-for-gdscript task.
        {
            "name": "Combined: GDScript",
            "type": "godot",
            "request": "attach",
            "address": "127.0.0.1",
            "port": 6008,
            "project": "${workspaceFolder}",
            "presentation": {
                "hidden": true
            }
        },
        {
            "name": "Combined: C#",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "wait-for-gdscript",
            "program": "${config:godotTools.editorPath.godot4}",
            "cwd": "${workspaceFolder}",
            "args": [
                "--path",
                "${workspaceFolder}",
                "--remote-debug",
                "tcp://127.0.0.1:6008"
            ],
            "presentation": {
                "hidden": true
            }
        },
        {
            "name": "Combined: C# (Select Scene)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "wait-for-gdscript",
            "program": "${config:godotTools.editorPath.godot4}",
            "cwd": "${workspaceFolder}",
            "args": [
                "--path",
                "${workspaceFolder}",
                "--remote-debug",
                "tcp://127.0.0.1:6008",
                "${command:godot.csharp.getLaunchScene}"
            ],
            "presentation": {
                "hidden": true
            }
        },
        {
            "name": "Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
    ]
}