; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Fmod]

General/banks_path="res://assets/banks"

[application]

config/name="rogue-cha-cha-cha"
run/main_scene="res://src/gameplay/main_game.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
Constants="*uid://dxaead012ysr3"
FmodManager="*uid://cds10pm7hwn3p"

[display]

window/size/viewport_width=320
window/size/viewport_height=224
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="golden-project"

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg", "res://addons/GDQuest_GDScript_formatter/plugin.cfg", "res://addons/fmod/plugin.cfg")

[file_customization]

folder_colors={
"res://src/debug/": "yellow"
}

[input]

